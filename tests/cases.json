{
  "version": 1,
  "default": [
    "unit",
    "format"
  ],
  "defaults": {},
  "cases": [
    {
      "name": "runner-contracts",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/runner_checks.py"
      ],
      "files": [
        "tests/runner_checks.py"
      ],
